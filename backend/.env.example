# 复制为 .env 并填入你自己的密钥
# 对话模型在网页「设置」中管理（任意 OpenAI 兼容接口，可配置多个、设默认、访客在对话框切换）。
# 下面的 DEEPSEEK_* 仅在首次启动时用于自动创建默认模型；DEEPSEEK_API_KEY 可被模型的"从 .env 读取"引用。
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型：deepseek-flash（V4.1 Flash，默认）| deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled（默认，更快更省）| enabled（显示思考过程，适合复杂推理）
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high        # low | high | max，仅思考模式
# LLM_RETRIES=2                         # 429/5xx/网络错误重试次数
# 可选：自定义系统提示词
# AGENT_SYSTEM_PROMPT=你是 Chris Li 的企业 AI 助手……

# 沙箱 runner 通信令牌：openssl rand -hex 32，同时写入 runner/.env
RUNNER_TOKEN=
# 管理员令牌：发布访客技能 / 公开知识库时使用（请求头 X-Admin-Token）
ADMIN_TOKEN=

# ---- 知识库语义检索（可选）----
# 不配置 EMBEDDING_API_KEY 时只用关键词检索。任意 OpenAI 兼容 /embeddings 接口均可（硅基流动、阿里云百炼、自托管 TEI 等）。
# 注意：使用第三方服务时，知识库文档文字会发送给该服务计算向量。
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3           # 或 Qwen/Qwen3-Embedding-0.6B / -4B / -8B（查询指令前缀会自动添加）
# 重排（可选，强烈推荐）：留空则不重排；默认复用上面的地址和密钥
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=
# RERANK_API_KEY=
# EMBEDDING_DAILY_TOKENS=5000000        # 全站每日向量+重排 token 上限

# 可选配额
# RATE_IP_PER_MIN=5
# VISITOR_DAILY_TURNS=10
# GLOBAL_DAILY_TOKENS=1000000
