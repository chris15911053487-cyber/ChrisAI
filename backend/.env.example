# 复制为 .env 并填入你自己的密钥
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：自定义系统提示词
# AGENT_SYSTEM_PROMPT=你是 Chris Li 的企业 AI 助手……
# 沙箱 runner 通信令牌：openssl rand -hex 32，同时写入 runner/.env
RUNNER_TOKEN=
# 管理员令牌：发布访客技能为公共技能时使用（请求头 X-Admin-Token）
ADMIN_TOKEN=
# 可选配额
# RATE_IP_PER_MIN=5
# VISITOR_DAILY_TURNS=10
# GLOBAL_DAILY_TOKENS=1000000
